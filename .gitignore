node_modules/
/dist/
# core 子包构建产物（node_modules/ 不带前缀已覆盖任意层级的 core/node_modules，
# 但 /dist/ 只匹配根目录，故需单独补 /core/dist/）
/core/dist/
# main 子包构建产物（同上，/dist/ 只匹配根目录）
/main/dist/
/dist-sea/
.sea-test/
sea-config.json
.env
*.log
.DS_Store
*.tsbuildinfo
.vscode/

# WebUI 前端工程（依赖与构建产物 webui/dist 均不入库，克隆后需 npm run build:webui 本地构建）
/webui/node_modules/
/webui/dist/

# 桌面端壳（Electron 子包：依赖与构建产物均不入库；安装包在任务 04 产出）
/desktop/node_modules/
/desktop/dist/
/desktop/build/
/desktop/resources/
/dist-desktop/

# Agent 运行时配置（workspace 配置与 Skill 统一存放于 {项目}/.loop-agent/，整体不进入版本控制）
.loop-agent/

# 记忆系统 - L2 情景记忆（按天分文件，运行时生成，仅项目根目录）
/memory/

# 记忆系统 - L3 Curated 常驻文件（运行时初始化，含用户个性化数据）
SOUL.md
USER.md
MEMORY.md

# 记忆系统 - Curated 去重备份（/memory curated dedupe 生成）
*.dedupe.bak

# 记忆系统 - Promotion Gate 状态
.memory-gate.json

# 调试日志
debug-*.log

# 临时错误日志 / 调试输出
err-*.txt

# 根目录临时分析脚本
analyze_logo.py

# 下载的依赖包（离线安装用，体积大不入库）
wheels/

# IDE 产物（Trae HTML 分享打包缓存）
.trae-html-share-packages/

# 临时工作文件（图表草稿、实验输出等，不入库）
/temp/

# 真实渲染探针的临时产物（截图 / summary.json / Chrome profile）
.tmp-verify-*/

# 会话内临时工作文件（commit message 草稿、对比快照等）
.tmp-*
