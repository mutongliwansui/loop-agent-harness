{
  "name": "loop-agent-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "LoopAgent 桌面端壳（Electron 主进程，独立子包，不进主工程运行时依赖）",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "start": "electron ."
  },
  "build": {
    "appId": "com.loopagent.desktop",
    "productName": "LoopAgent",
    "extraMetadata": {
      "name": "LoopAgent"
    },
    "directories": {
      "output": "../dist-desktop",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/loop-agent-core.exe",
        "to": "loop-agent-core.exe"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "LoopAgent-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "include": "nsis/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LoopAgent",
      "artifactName": "LoopAgent-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "LoopAgent-Portable-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
