{
  "name": "loop-agent-command",
  "version": "0.2.0",
  "description": "ReAct Agent with OpenAI function calling",
  "type": "module",
  "workspaces": [
    "core",
    "main"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "build:sea": "node scripts/build-sea.mjs",
    "build:webui": "npm --prefix webui run build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:full": "vitest run",
    "test:related": "vitest related --run"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "openai": "^4.71.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.2",
    "postject": "^1.0.0-alpha.6",
    "punycode": "^2.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
