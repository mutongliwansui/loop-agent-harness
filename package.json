{
  "name": "loop-agent-command",
  "version": "0.1.0",
  "description": "ReAct Agent with OpenAI function calling",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "build:sea": "node scripts/build-sea.mjs",
    "build:webui": "npm --prefix webui run build",
    "start": "tsx src/index.ts",
    "serve": "tsx src/index.ts --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "openai": "^4.71.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "postject": "^1.0.0-alpha.6",
    "punycode": "^2.3.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
