# OpenAI API Key（必填）
OPENAI_API_KEY=sk-xxx

# OpenAI 协议 Base URL（可选，默认 https://api.openai.com/v1）
# 可切换为 DeepSeek: https://api.deepseek.com/v1
# 可切换为 Moonshot: https://api.moonshot.cn/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称（可选，默认 gpt-4o-mini）
# 注意：MODEL_NAME 必须与上面的 OPENAI_BASE_URL 属于同一家服务商
#   OpenAI   -> gpt-4o-mini
#   DeepSeek -> deepseek-chat（Base URL 需改为 https://api.deepseek.com/v1）
#   Moonshot -> moonshot-v1-8k（Base URL 需改为 https://api.moonshot.cn/v1）
MODEL_NAME=gpt-4o-mini

# Agent 最大迭代次数（可选，默认 100）
MAX_ITERATIONS=100

# 真实模型集成测试开关（可选，默认关闭）
# tests/integration/ 下 a/b/c/d/f/g 六个用例会真实调用模型，默认跳过。
# 需要联调时设为 1（凭据取 OPENAI_API_KEY，缺失时回落到 ~/.loop-agent/config.json）：
#   1/true/yes/on 才开启，其余值一律跳过
LOOP_AGENT_LIVE_MODEL=0
